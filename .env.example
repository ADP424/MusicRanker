# Copy to .env and fill in. Everything without a default is required.

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
DATABASE=music_ranker
DB_USER=music_ranker
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Pin the search_path to one schema (e.g. a copy of the data to experiment on).
# DB_SCHEMA=

# ── Running ──────────────────────────────────────────────────────────────────
# "dev" relaxes cookie security for plain-http localhost. `python main.py`
# sets it for you; leave it unset (production) anywhere else.
# APP_ENV=dev
# Behind a reverse proxy, how many proxies to trust in X-Forwarded-For (rate limits).
# TRUSTED_PROXY_HOPS=0
# Only needed when the frontend is served from another origin than the API.
# FRONTEND_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
# SESSION_TTL_DAYS=30
# INVITE_TTL_DAYS=30
# JOB_RETENTION_DAYS=30
# Write a pg_dump snapshot to server/snapshots/ on every shutdown.
# SNAPSHOT_ON_SHUTDOWN=false

# ── TMDB (movies, TV): https://www.themoviedb.org/settings/api ───────────────
TMDB_BEARER_TOKEN=
# TMDB_RPS=20
# TMDB_BURST=40
# TMDB_CONCURRENCY=1
# TMDB_CACHE_PATH=./var/tmdb_cache.sqlite3

# ── IGDB (games): a Twitch app, https://api-docs.igdb.com/#account-creation ──
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# IGDB_RPS=3
# IGDB_BURST=4
# IGDB_CACHE_PATH=./var/igdb_cache.sqlite3
